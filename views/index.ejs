<%- include("partials/header.ejs") %>

<div class="container">

    <div class="top-section">
        <h1>My Blog</h1>
        <a href="/create" class="create-btn">Create New Post</a>
    </div>
    <section class="posts">
        <% if (posts.length === 0) { %>
            <p>No posts yet. Create your first blog post!</p>
        <% } else { %>
            <% posts.forEach(post => { %>
                <article class="post">
                    <h2><%= post.title %></h2>
                    <p><%= post.content %></p>
                    <div class="post-actions">
                        <a href="/edit/<%= post.id %>">
                            Edit
                        </a>
                        <form action="/delete/<%= post.id %>" method="POST">
                            <button type="submit">
                                Delete
                            </button>
                        </form>
                    </div>
                </article>
            <% }) %>
        <% } %>
    </section>
</div>


<%- include("partials/footer.ejs") %>